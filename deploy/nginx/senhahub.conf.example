# Modelo: substitua o certificado, dominio e endereco interno antes de usar.
server {
    listen 80;
    server_name senhahub.interno.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name senhahub.interno.example;

    ssl_certificate /etc/letsencrypt/live/senhahub.interno.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/senhahub.interno.example/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
    }
}
