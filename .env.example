# Ambiente
NODE_ENV=development

# Backend PostgreSQL
# A API roda no servidor que possui acesso ao PostgreSQL. O front da Vercel
# encaminha /api/* para API_SERVER_URL.
API_SERVER_URL=
# Origens HTTPS autorizadas quando o front e a API usam hosts diferentes.
API_ALLOWED_ORIGINS=https://senhahub.vercel.app
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# URL PostgreSQL usada somente pelo servidor da API.
LOCAL_DATABASE_URL=
# Limite do pool PostgreSQL local para o servidor da aplicação.
LOCAL_PG_POOL_MAX=10

# Ativa as rotas e os aliases que usam o PostgreSQL.
LOCAL_POSTGRES_ROUTES_ENABLED=1
LOCAL_POSTGRES_APP_ENABLED=1
# Somente para desenvolvimento/transicao. Deve permanecer 0 em producao.
LOCAL_POSTGRES_ALLOW_LEGACY_FALLBACK=0
# Chave local/externa usada somente para criptografar dumps de backup.
# Nunca use a mesma chave de AUTH_SECRET e nunca a versione.
BACKUP_ENCRYPTION_KEY=
# URL do banco que será copiado; se vazia, usa LOCAL_DATABASE_URL e depois DATABASE_URL.
BACKUP_DATABASE_URL=
# URL administrativa separada, necessária apenas para exportar roles do PostgreSQL.
# Nunca use o usuário de aplicação como superusuário; mantenha esta variável só no servidor de backup.
BACKUP_ROLES_DATABASE_URL=
# Pasta local de trabalho dos backups criptografados.
BACKUP_OUTPUT_DIR=./backups/postgres
# Pasta externa ao projeto (disco externo ou pasta sincronizada privada gratuita).
BACKUP_OFFSITE_DIR=
# Opcional: diretório que contém pg_dump, pg_dumpall e psql.
POSTGRES_BIN_DIR=
SUPABASE_AUTH_ENABLED=0
DATA_BACKEND=local-postgres
SUPABASE_AUTO_CONFIRM_CUSTOMERS=0
# Em produção local, use 0 para bloquear cadastro sem verificação de e-mail.
LOCAL_PUBLIC_REGISTRATION_ENABLED=0

# Politica gratuita de senha: consulta HIBP por k-anonymity no servidor.
# Somente o prefixo do hash SHA-1 e enviado; a senha completa nunca sai daqui.
HIBP_RANGE_URL=https://api.pwnedpasswords.com/range/
HIBP_TIMEOUT_MS=2500

# Segredo usado para assinar cookies de sessao.
# Em producao, use um valor aleatorio com 32+ caracteres e mantenha fixo.
AUTH_SECRET=troque-por-um-segredo-longo-com-32-ou-mais-caracteres

# Segredo para a rota interna de jobs, caso seja acionada pelo monitoramento do servidor.
CRON_SECRET=troque-por-um-segredo-longo-e-exclusivo

# Opcional: webhook próprio para alertas de falha do Cron e da impressão.
# Sem esta variável, os alertas ficam disponíveis nos logs estruturados e na rota administrativa.
OBSERVABILITY_ALERT_WEBHOOK_URL=

# Pasta de compatibilidade; não é usada quando DATA_BACKEND=local-postgres.
DATA_DIR=./data

# Gestor inicial, usado apenas enquanto o backend ainda estiver no fluxo atual.
BOOTSTRAP_ADMIN_NAME=Gestor Inicial
BOOTSTRAP_ADMIN_EMAIL=troque-pelo-email-do-gestor
BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-com-12-ou-mais-caracteres

# Fluxo do Totem: central permite escolher o setor; sector fixa um setor no dispositivo.
KIOSK_MODE=central
KIOSK_SECTOR_ID=acougue

# Opcional: contas de demonstracao fora do codigo.
# Preencha no .env local ou na Vercel, nunca com senhas reais no Git.
DEMO_USERS_JSON=[]

# Use apenas para ambiente demo/teste, nunca em producao real.
ALLOW_DEMO_USERS=0

# PWA e Web Push.
# Gere o par VAPID com: npx web-push generate-vapid-keys
# Ative somente depois de cadastrar as tres variaveis VAPID.
PUSH_NOTIFICATIONS_ENABLED=0
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seu-dominio.com

# Totem e fila de impressao.
PUBLIC_APP_URL=https://senhahub.vercel.app
PUBLIC_INSTALL_URL=https://senhahub.vercel.app/instalar
KIOSK_ID=totem-pompeia-01
# Ative somente quando um proxy confiavel, como Cloudflare, substituir os cabecalhos de IP.
# Em producao atras do Cloudflare, use tambem CF-Connecting-IP.
TRUST_PROXY_HEADERS=1
KIOSK_NAME=Totem Supermercado Pompeia
KIOSK_PRINTER_NAME=Bematech MP - 4200 TH
KIOSK_PRINTER_PORT=COM5
KIOSK_PAPER_WIDTH_MM=80
# Gere um segredo exclusivo com: openssl rand -base64 48
PRINT_AGENT_TOKEN=
# Usado somente pelo simulador local quando a API estiver em outro endereco.
PRINT_API_URL=http://localhost:3000

# Configuracao serial do agente Windows da Bematech.
PRINT_SERIAL_BAUD_RATE=115200
PRINT_SERIAL_DATA_BITS=8
PRINT_SERIAL_STOP_BITS=1
PRINT_SERIAL_PARITY=none
PRINT_SERIAL_RTSCTS=0
PRINT_STATUS_CHECK_ENABLED=0
PRINT_STATUS_TIMEOUT_MS=1500
PRINT_POLL_INTERVAL_MS=2000
PRINT_RETRY_MAX_MS=60000
PRINT_AGENT_STATE_DIR=./data/print-agent
